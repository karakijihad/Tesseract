tesseract/browser/
tesseract/downloads/
# Repo-root downloads/ catches ad-hoc artefacts when TARS shells out from
# Bash (cwd=repo root) instead of using file_write — see 2026-05-17 stray
# `downloads/elevated-toilet-seat.{png,svg}` incident. file_write now
# rewrites relative paths under tesseract/, but subprocess writes still
# land here on the off chance one slips through.
downloads/
.playwright-mcp/
.playwright-cli/
tesseract/mirror/playwright-report/
tesseract/mirror/test-results/
tesseract/mirror/e2e/.auth/
tesseract/mirror/node_modules/.cache/

