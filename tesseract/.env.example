# TESSERACT Environment Configuration
# Copy this to .env and fill in your values. NEVER commit .env.
#
# Two access paths:
#   CLI (subscriptions) — Claude Code, Codex CLI. No keys needed — uses local OAuth.
#   API (pay-per-token) — requires keys below.

# ── API Keys ──────────────────────────────────────────────
# Provider    | Signup                              | Pricing
# OpenAI      | https://platform.openai.com/signup  | https://openai.com/api/pricing
# Anthropic   | https://console.anthropic.com       | https://www.anthropic.com/pricing
# Google      | https://aistudio.google.com         | https://ai.google.dev/pricing
# DeepSeek    | https://platform.deepseek.com       | https://api-docs.deepseek.com/quick_start/pricing
# xAI (Grok)  | https://console.x.ai                | https://x.ai/api
# Mistral     | https://console.mistral.ai          | https://mistral.ai/pricing

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# GOOGLE_API_KEY covers chat_brain Gemini fallback, voice STT (Gemini
# Flash audio) and voice TTS (Gemini Flash TTS). One key, one billing
# account — no OAuth2 / ADC plumbing anywhere in the runtime.
GOOGLE_API_KEY=
DEEPSEEK_API_KEY=
# XAI_API_KEY backs the chat_brain Grok primary. ~$150/mo free credits via
# the data-sharing program: enable at Console → Settings → Data Sharing
# ("Share API Inputs for Model Training"); requires ~$5 prior spend, is
# team-level + admin-only, and credits appear within 24h and refresh monthly.
XAI_API_KEY=
MISTRAL_API_KEY=

# ── Ollama (local) ────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434

# ── Search (Tavily) ───────────────────────────────────────
# Free 1K calls/month at https://tavily.com — used by `tavily_search`,
# `tavily_extract`, and the `provider_watch` scheduler job.
TAVILY_API_KEY=

# ── Telegram bridge ───────────────────────────────────────
# Operator-only today. Create a bot via @BotFather (https://t.me/BotFather),
# copy the token here. TELEGRAM_ALLOWED_CHAT_IDS is a comma-separated list
# of allowlisted chat_ids — send /start to your bot once and the bridge
# will print your chat_id in the Mirror log; add it here, restart Mirror.
# Empty/missing token = bridge disabled (no crash, just a one-line info log).
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_IDS=
# Optional default chat_id for the outbound `TelegramNotifyJob` scheduler
# task. Leave empty if no scheduled pushes are configured.
TELEGRAM_DEFAULT_CHAT_ID=

# ── Runtime ───────────────────────────────────────────────
TESSERACT_LOG_LEVEL=INFO
TESSERACT_SESSION_DIR=sessions
TESSERACT_MEMORY_DIR=memory-store
