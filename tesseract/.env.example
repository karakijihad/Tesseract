# TESSERACT / the assistant — environment configuration
#
# A copy of this file is made automatically on first run
# (config_seed.py::ensure_env_seeded) at <TESSERACT_HOME>/.env. Every key
# below is optional — the assistant boots and runs with none of them set
# (local voice, memory, and vault all work with zero keys). Fill in what you
# want, then restart the app — .env is read once at boot, not hot-reloaded.
# Never commit a real .env; this template ships blank.
#
# Settings → Keys edits this file and is rendered FROM it: each section
# below is a tab there, each comment is the line under its key. SETUP.md
# walks through what a key gets you.

# ── API keys ────────────────────────────────────────────────────────
# Providers. A key here says an account exists, nothing more — which role
# uses which provider is decided in Settings → Model roles (or
# config/roles.yaml), and any provider can serve any role.
#
# (The blank line above matters: a comment block that runs into a key
# becomes that key's caption in Settings, and this paragraph is about the
# section, not about OpenAI.)

# https://platform.openai.com/signup
OPENAI_API_KEY=
# Free tier, no payment method. https://build.nvidia.com/
BUILD_NVIDIA_KEY=
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# https://console.x.ai
XAI_API_KEY=
# https://aistudio.google.com
GOOGLE_API_KEY=
# Unlocks the `web_search` tool. Free tier, 2K requests a month.
# https://brave.com/search/api/
BRAVE_SEARCH_API_KEY=
# Unlocks `tavily_search` and `tavily_extract` — search, plus pulling a
# page's full text in so it can be indexed into the vault. Free tier, 1K
# requests a month. https://tavily.com
TAVILY_API_KEY=

# ── Channels ────────────────────────────────────────────────────────
# Talking to the assistant from somewhere other than this app. Create a bot
# via @BotFather and copy its token here; an empty token means the bridge is
# off, with no error.
# https://t.me/BotFather
TELEGRAM_BOT_TOKEN=
# Comma-separated allowlist of chat_ids. Send /start to your bot once and
# the bridge prints your chat_id in the log; add it here and restart.
TELEGRAM_ALLOWED_CHAT_IDS=
# Where scheduled notifications go, when one is configured to push.
TELEGRAM_DEFAULT_CHAT_ID=

# ── MCP ─────────────────────────────────────────────────────────────
# One bearer token, for connecting another tool to this one. Generate it in
# Settings → Keys → MCP, which also hands you the address and a config block
# to paste. It is a secret you mint, not a signup key — by hand it is:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# A request whose token does not match this one is refused.
TESSERACT_MCP_SECRET=

# ── What is deliberately NOT here ───────────────────────────────────
#
# Every line above is a secret, and Settings renders this whole file as
# masked fields. So anything that is not a secret does not belong in it: a
# row of dots asks to be treated as a password, and the reader has no way to
# know it is looking at a URL or a word from a list of four.
#
# TESSERACT_MCP_LANE_CLAUDE_TOKEN, TESSERACT_MCP_LANE_CODEX_TOKEN and
# TESSERACT_MCP_TERMINAL_TOKEN — the identities the runtime issues to
# processes it spawns. Minted into this file on first boot and handed out one
# per process, so a spawned lane cannot come back in holding the operator
# token above. Machinery, not a setting.
#
# TESSERACT_LOG_LEVEL — how much the long-lived CLI scripts print. The app
# itself does NOT read it: what the backend writes to its log files is
# `mirror.yaml::logging.file_min_levels`, and what you actually read is the
# live feed in Channels → Logs. Offering it here was offering a dial wired
# to nothing.
#
# OLLAMA_BASE_URL — only for an Ollama on another machine. First-run setup
# installs one here, so the default in `providers.yaml` is already right.
#
# All three still work if you set them by hand. None is worth a row.
