# TESSERACT / the assistant — environment configuration
#
# A copy of this file is made automatically on first run
# (config_seed.py::ensure_env_seeded) at <TESSERACT_HOME>/.env. Every key
# below is optional — the assistant boots and runs with none of them set (local
# voice, memory, and vault all work with zero keys). Each unlocks the
# capability noted next to it; leaving it blank just means that capability
# is off until you add it. Fill in what you want, then restart the app —
# .env is read once at boot, not hot-reloaded. Never commit a real .env;
# this template ships blank.
#
# If you only read one line of this file: set OPENAI_API_KEY. That is the
# one key the shipped configuration needs to hold a conversation.
# SETUP.md walks through the rest.

# ── 1. Chat — the one key that makes the assistant answer you ────────────────
# The shipped roles.yaml wires chat_brain to OpenAI's gpt-5.6-luna, with
# gpt-5.4-mini and then Grok behind it. This one key gets you a working
# conversation and a working fallback.
# https://platform.openai.com/signup
OPENAI_API_KEY=

# ── 2. Background work — free, and worth adding ─────────────────────
# NVIDIA's build tier is free and needs no payment method. The shipped
# config points background roles at it: the observer, sub-agents, and the
# autonomy loop. Without this key those roles fall through to OpenAI, so
# you pay for work you never see.
# https://build.nvidia.com/
BUILD_NVIDIA_KEY=

# ── 3. Other chat providers — any ONE can replace section 1 ─────────
# All are enabled in providers.yaml; none is wired to a role by default.
# To use one, add its key here and repoint chat_brain in Settings →
# Model roles (or edit config/roles.yaml). See SETUP.md § Swapping models.
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# https://console.x.ai — also arms the image_generator fallback (Grok
# Imagine, text-to-image + image-to-image, cheaper than the primary).
XAI_API_KEY=
# https://aistudio.google.com — carries more of the shipped config than any
# other single key: several background roles, voice STT, and BOTH ops of
# image generation (the image_generator primary). One key, one billing
# account. Note that image generation is paid on every provider in the
# catalog — there is no free image lane.
GOOGLE_API_KEY=

# ── 4. Web research — two separate tools, two separate keys ─────────
# These are NOT interchangeable and neither falls back to the other.
# With neither set, the assistant still answers from memory, the vault, and the
# model's own knowledge — it just cannot reach the live web, and says so
# when you ask it to rather than failing quietly.
#
# Unlocks the `web_search` tool.
# https://brave.com/search/api/ (free tier, 2K req/mo)
BRAVE_SEARCH_API_KEY=
# Unlocks `tavily_search` and `tavily_extract` (search, plus pulling a
# page's full text in so it can be indexed into the vault).
# https://tavily.com (free tier, 1K req/mo)
TAVILY_API_KEY=

# ── 5. OPTIONAL — Telegram channel ──────────────────────────────────
# Create a bot via @BotFather (https://t.me/BotFather), copy the token
# here. TELEGRAM_ALLOWED_CHAT_IDS is a comma-separated allowlist of
# chat_ids — send /start to your bot once and the bridge prints your
# chat_id in the Mirror log; add it here and restart. Empty/missing
# token = bridge disabled, no crash.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_IDS=
# Optional default chat_id for the outbound scheduled-notification job.
TELEGRAM_DEFAULT_CHAT_ID=

# ── 6. OPTIONAL — local model server ────────────────────────────────
# First-run setup installs Ollama and pulls the embedding model for you,
# so this is normally left blank. Set it only if Ollama runs somewhere
# other than this machine's localhost. Without Ollama, memory and vault
# search still work — they fall back to keyword (BM25) matching instead
# of semantic similarity.
OLLAMA_BASE_URL=

# ── 7. ADVANCED — leave empty unless you know why ───────────────────
# Log verbosity (DEBUG/INFO/WARNING/ERROR); defaults to INFO.
TESSERACT_LOG_LEVEL=
# Bearer tokens for the local MCP server (mcp.yaml) — secrets you
# generate yourself, not a signup key. Only needed if you're exposing
# TESSERACT as an MCP server to another tool: one token per client
# identity, and a request whose token matches none of them is refused.
# Generate them in Settings → API keys (the Generate button mints one and
# writes it here), or by hand with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Settings lists the verbs each token unlocks next to the token itself.
TESSERACT_MCP_SECRET=
TESSERACT_MCP_LANE_CLAUDE_TOKEN=
TESSERACT_MCP_LANE_CODEX_TOKEN=
TESSERACT_MCP_TERMINAL_TOKEN=
