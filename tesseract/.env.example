# TESSERACT / TARS — environment configuration
#
# A copy of this file is made automatically on first run
# (config_seed.py::ensure_env_seeded) at <TESSERACT_HOME>/.env. Every key
# below is optional — TARS boots and runs with none of them set (local
# voice, memory, and vault all work with zero keys). Each unlocks the
# capability noted next to it; leaving it blank just means that capability
# is off until you add it. Fill in what you want, then restart the app —
# .env is read once at boot, not hot-reloaded. Never commit a real .env;
# this template ships blank.

# ── Chat (LLM) — unlocks TARS actually answering you ────────────────
# roles.yaml::chat_brain tries these in order; the first one with a key
# present (and not disabled in providers.yaml) wins. Set any ONE to get
# chat working — more just adds fallback depth.
# https://platform.openai.com/signup
OPENAI_API_KEY=
# https://console.x.ai — also unlocks higher-quality image generation
# (image-to-image + text-to-image) once set as an image_generator fallback.
XAI_API_KEY=
# https://aistudio.google.com — also covers voice STT/TTS (Gemini Flash
# audio/TTS), one key one billing account.
GOOGLE_API_KEY=
# https://platform.deepseek.com — DeepSeek ships disabled in
# providers.yaml (api.deepseek.enabled: false); set the key AND flip
# that to true to use it.
DEEPSEEK_API_KEY=
# https://build.nvidia.com/ (free developer tier, no payment method) —
# free chat/vision fallback and the default image-generation provider (FLUX).
BUILD_NVIDIA_KEY=

# ── Web research — unlocks the web_search / tavily_extract tools ────
# https://app.tavily.com/ (free tier available)
TAVILY_API_KEY=
# https://brave.com/search/api/ (free tier, 2K req/mo) — alternate
# backend for the web_search tool.
BRAVE_SEARCH_API_KEY=

# ── OPTIONAL — Telegram channel ─────────────────────────────────────
# Create a bot via @BotFather (https://t.me/BotFather), copy the token
# here. TELEGRAM_ALLOWED_CHAT_IDS is a comma-separated allowlist of
# chat_ids — send /start to your bot once and the bridge prints your
# chat_id in the Mirror log; add it here and restart. Empty/missing
# token = bridge disabled, no crash.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_IDS=
# Optional default chat_id for the outbound scheduled-notification job.
TELEGRAM_DEFAULT_CHAT_ID=

# ── OPTIONAL — local model server ───────────────────────────────────
# Install Ollama (https://ollama.com) and run `ollama pull
# nomic-embed-text` for memory/vault embeddings — no chat key covers this,
# it's a separate local model. Defaults to localhost; leave blank unless
# Ollama runs elsewhere.
OLLAMA_BASE_URL=
# Second Ollama host reached over your own network, if you run models
# on a separate machine. Ollama ignores the key's value, but it must
# be a non-empty placeholder once OLLAMA_LAN_BASE_URL is set.
OLLAMA_LAN_BASE_URL=
OLLAMA_LAN_API_KEY=

# ── ADVANCED — leave empty unless you know why ──────────────────────
# Log verbosity (DEBUG/INFO/WARNING/ERROR); defaults to INFO.
TESSERACT_LOG_LEVEL=
# Bearer tokens for the local MCP server (mcp.yaml) — secrets you
# generate yourself, not a signup key. Only needed if you're exposing
# TESSERACT as an MCP server to another tool.
TESSERACT_MCP_SECRET=
TESSERACT_MCP_LANE_CLAUDE_TOKEN=
TESSERACT_MCP_LANE_CODEX_TOKEN=
TESSERACT_MCP_TERMINAL_TOKEN=
