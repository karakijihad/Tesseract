# Deny Rules — Absolute, nothing overrides these.
# Format: tool_name:glob_pattern
# First match wins. Checked before ask rules.
# A hook "allow" re-runs these rules — deny ALWAYS blocks.

# Dangerous file operations
file_write:*/.env*
file_write:*/.env.local*
file_write:*/credentials*
file_write:*/secrets*
file_write:*/.ssh/*
file_write:*/.gnupg/*
file_edit:*/.env*
file_edit:*/.env.local*
file_edit:*/credentials*
file_edit:*/secrets*

# Policy files — prevent self-modification of security rules
file_write:*/policies/*
file_edit:*/policies/*

# Dangerous bash commands
bash:*rm -rf*
bash:*rm -r /*
bash:*rmdir /s*
bash:*del /f /s*
bash:*format *
bash:*mkfs*
bash:*dd if=*
bash:*> /dev/sd*
bash:*curl*|*sh*
bash:*wget*|*sh*
bash:*curl*|*bash*
bash:*wget*|*bash*
bash:*eval*
bash:*python -c*import os*
bash:*:(){ :|:& };:*

# Network exfiltration
bash:*curl*POST*
bash:*wget*--post*
bash:*nc -e*
bash:*ncat*

# Git force operations
bash:*git push --force*
bash:*git push -f*
bash:*git reset --hard*

# System modification
bash:*chmod 777*
bash:*chown root*
bash:*sudo*
bash:*powershell*-ExecutionPolicy*Bypass*
