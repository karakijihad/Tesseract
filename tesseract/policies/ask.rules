# Ask Rules — Prompt user for approval before executing.
# Format: tool_name:glob_pattern
# Checked after deny rules. First match wins.
# In "dontAsk" mode these are auto-allowed (but deny rules still block).

# Memory writes — confirm before modifying entity state
file_write:*/memory-store/*
file_edit:*/memory-store/*
memory_save:*
memory_update:*
memory_forget:*

# Vault ingestion — confirm before adding to immutable vault
vault_ingest:*

# Config changes — confirm before modifying system behavior
file_write:*/config/*
file_edit:*/config/*

# Package management
bash:*pip install*
bash:*pip uninstall*
bash:*npm install*
bash:*npm uninstall*

# Git operations that affect remote
bash:*git push*
bash:*git pull*
bash:*git merge*
bash:*git rebase*
bash:*git checkout*

# File deletion
bash:*rm *
bash:*del *

# Agent creation — confirm before writing a new sub-agent definition
agent_create:*

# Any write outside tesseract/ directory
file_write:*
file_edit:*
