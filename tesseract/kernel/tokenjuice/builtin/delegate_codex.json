{
  "id": "delegate_codex.default",
  "family": "delegate",
  "description": "delegate_codex transcript — same shape as delegate_claude.",
  "priority": 60,
  "match": {"tool_names": ["delegate_codex"]},
  "transforms": ["strip_ansi", "trim_empty_edges"],
  "reducers": [
    {"kind": "head_tail", "head": 60, "tail": 30}
  ],
  "passthrough_when": {"max_lines": 100}
}
