[
  {
    "id": "bash.git_status",
    "family": "bash.git",
    "description": "Compact git status — drop verbose hints, keep changed-file lines.",
    "priority": 80,
    "match": {
      "tool_names": ["bash"],
      "arg_path": "command",
      "arg_includes_any": ["git status"]
    },
    "transforms": ["strip_ansi", "trim_empty_edges"],
    "reducers": [
      {
        "kind": "drop_regex",
        "patterns": [
          "^\\s+\\(use \"git ",
          "^\\s+\\(commit or discard",
          "^Your branch is up to date",
          "^nothing added to commit"
        ]
      },
      {"kind": "head_tail", "head": 40, "tail": 10}
    ],
    "passthrough_when": {"max_chars": 800},
    "on_empty": "(git status: clean working tree)"
  },
  {
    "id": "bash.git_log",
    "family": "bash.git",
    "description": "git log — head plus tail; a full-body log of 20 commits runs to ~600 lines.",
    "priority": 75,
    "match": {
      "tool_names": ["bash"],
      "arg_path": "command",
      "arg_includes_any": ["git log"]
    },
    "transforms": ["strip_ansi", "trim_empty_edges"],
    "reducers": [
      {"kind": "head_tail", "head": 120, "tail": 20}
    ],
    "passthrough_when": {"max_lines": 140}
  },
  {
    "id": "bash.ls_long",
    "family": "bash.fs",
    "description": "ls -la / dir-walk output — dedup + truncate.",
    "priority": 60,
    "match": {
      "tool_names": ["bash"],
      "arg_path": "command",
      "arg_regex": "(^|[|;&]\\s*)ls(\\s|$)"
    },
    "transforms": ["strip_ansi", "dedup_adjacent", "trim_empty_edges"],
    "reducers": [
      {"kind": "head_tail", "head": 50, "tail": 10}
    ],
    "passthrough_when": {"max_lines": 80}
  },
  {
    "id": "bash.find",
    "family": "bash.fs",
    "description": "find / fd recursive dump — dedup, then head plus tail.",
    "priority": 60,
    "match": {
      "tool_names": ["bash"],
      "arg_path": "command",
      "arg_regex": "(^|[|;&]\\s*)(find|fd|fdfind)\\s"
    },
    "transforms": ["strip_ansi", "trim_empty_edges"],
    "reducers": [
      {"kind": "dedup_lines"},
      {"kind": "head_tail", "head": 120, "tail": 20}
    ],
    "passthrough_when": {"max_lines": 140}
  },
  {
    "id": "bash.docker_ps",
    "family": "bash.docker",
    "description": "docker ps / images — keep header + first 30 rows.",
    "priority": 50,
    "match": {
      "tool_names": ["bash"],
      "arg_path": "command",
      "arg_includes_any": ["docker ps", "docker images", "docker container ls"]
    },
    "transforms": ["strip_ansi", "trim_empty_edges"],
    "reducers": [
      {"kind": "head_tail", "head": 30, "tail": 6}
    ],
    "passthrough_when": {"max_lines": 40}
  },
  {
    "id": "bash.kubectl_get",
    "family": "bash.k8s",
    "description": "kubectl get / describe — head 60 lines.",
    "priority": 50,
    "match": {
      "tool_names": ["bash"],
      "arg_path": "command",
      "arg_includes_any": ["kubectl get", "kubectl describe", "kubectl logs"]
    },
    "transforms": ["strip_ansi", "trim_empty_edges"],
    "reducers": [
      {"kind": "head_tail", "head": 60, "tail": 10}
    ],
    "passthrough_when": {"max_lines": 80}
  }
]
