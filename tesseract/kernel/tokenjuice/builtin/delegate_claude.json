{
  "id": "delegate_claude.default",
  "family": "delegate",
  "description": "delegate_claude transcript — keep head + tail; intermediate prose elides.",
  "priority": 60,
  "match": {"tool_names": ["delegate_claude", "delegate_codex_via_claude"]},
  "transforms": ["strip_ansi", "trim_empty_edges"],
  "reducers": [
    {"kind": "head_tail", "head": 60, "tail": 30}
  ],
  "passthrough_when": {"max_lines": 100}
}
