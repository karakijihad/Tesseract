{
  "id": "delegate_auditor.default",
  "family": "delegate",
  "description": "delegate_auditor transcript \u2014 same shape as delegate_coder.",
  "priority": 60,
  "match": {
    "tool_names": [
      "delegate_auditor"
    ]
  },
  "transforms": [
    "strip_ansi",
    "trim_empty_edges"
  ],
  "reducers": [
    {
      "kind": "head_tail",
      "head": 60,
      "tail": 30
    }
  ],
  "passthrough_when": {
    "max_lines": 100
  }
}
