{
  "id": "delegate_coder.default",
  "family": "delegate",
  "description": "delegate_coder transcript \u2014 keep head + tail; intermediate prose elides.",
  "priority": 60,
  "match": {
    "tool_names": [
      "delegate_coder"
    ]
  },
  "transforms": [
    "strip_ansi",
    "trim_empty_edges"
  ],
  "reducers": [
    {
      "kind": "head_tail",
      "head": 60,
      "tail": 30
    }
  ],
  "passthrough_when": {
    "max_lines": 100
  }
}
